[Unit]
Description=TaskLane MCP control plane (Streamable HTTP, localhost)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

# Adjust User=, paths, and the Python interpreter to your install.
[Service]
Type=simple
User=tasklane
Group=tasklane
WorkingDirectory=/opt/tasklane
Environment="HOME=/home/tasklane"
Environment="TASKLANE_HOME=/opt/tasklane/data"
Environment="PYTHONPATH=/opt/tasklane"
Environment="PATH=/home/tasklane/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/tasklane/venv/bin/python -m tasklane.mcp_server
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5

[Install]
WantedBy=multi-user.target
